<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" stylesheets="@../view/main.css">

	<top>
		<Label fx:id="statusLabel" text="起動中..." />
	</top>

	<center>
		<TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
			<tabs>
				
				<Tab fx:id="configTab" text="基本設定">
					<content>
						<VBox spacing="20">
							<padding>
								<Insets top="20" right="20" bottom="20" left="20"/>
							</padding>
							<VBox spacing="10">
								<Label text="① ショートカットキー選択" styleClass="section-title"/>
								<HBox spacing="15">
									<ComboBox fx:id="triggerKeyBox">
									</ComboBox>
									<Label fx:id="keyCombinationLabel"/>
								</HBox>
								<HBox spacing="5">
									<Label text="ーーカスタムキー設定ーー"/>
								</HBox>
								<HBox spacing="10" alignment="CENTER_LEFT">
									<TextField fx:id="inputKeyText" promptText="ショートカットキーにしたいキーを入力" disable="true"/>
									<Label text="+"/>
									<CheckBox fx:id="checkAlt" text="Alt"/>
									<Label text="+"/>
									<CheckBox fx:id="checkCtrl" text="Ctrl"/>
									<Label text="+"/>
									<CheckBox fx:id="checkShift" text="Shift"/>
								</HBox>
							</VBox>
							<VBox spacing="10">
								<Label text="② 保存先フォルダ選択" styleClass="section-title"/>
								<HBox spacing="10">
									<Button text="選択..." onAction="#onSelectFile"/>
									<TextField fx:id="filePath" promptText="選択されたフォルダ" editable="false"/>
								</HBox>
							</VBox>
							<VBox spacing="10">
								<Label text="③ 撮影範囲" styleClass="section-title"/>
								<ComboBox fx:id="snapAreaBox">
								</ComboBox>
							</VBox>
							<VBox spacing="10">
								<Label text="④ 拡張子" styleClass="section-title"/>
								<ComboBox fx:id="formatBox">
								</ComboBox>
							</VBox>

							<VBox spacing="10">
								<Label text="⑤ 撮影後の動作" styleClass="section-title"/>
								<ComboBox fx:id="afterBox">
								</ComboBox>
							</VBox>

							<VBox spacing="10">
								<Label text="⑥ クリップボードに画像を保存する" styleClass="section-title"/>
								<CheckBox fx:id="checkClipboard" text="有効にする"/>
							</VBox>
						</VBox>
					</content>
				</Tab>
				
				<Tab fx:id="otherTab" text="その他設定">
					<content>
						<VBox spacing="20">
							<padding>
								<Insets top="20" right="20" bottom="20" left="20"/>
							</padding>
							<Label text="ここに新しい設定項目や、履歴などを追加できます。" />
						</VBox>
					</content>
				</Tab>
				<Tab fx:id="otherTab" text="履歴">
				</Tab>
			</tabs>
		</TabPane>
	</center>

	<bottom>
		<HBox spacing="20" alignment="CENTER">
			<padding>
				<Insets top="10" right="20" bottom="20" left="20"/>
			</padding>
			<children>
				<Button text="設定を初期化" onAction="#onResetConfig" style="-fx-min-width: 100;"/>
				<Button text="設定を反映" onAction="#onApplyConfig" prefWidth="120" style="-fx-base: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
			</children>
		</HBox>
	</bottom>

</BorderPane>