<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" stylesheets="@../css/main.css">

	<top>
		<HBox styleClass="top-bar">
        	<Label fx:id="labelStatus" text="起動中..." />
        	<Region HBox.hgrow="ALWAYS" />
        	<Label text="Language" />
        	<ComboBox fx:id="comboLanguageType" styleClass="language-combo"/>
    	</HBox>
	</top>

	<center>
		<TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
			<tabs>
				<Tab fx:id="configTab" text="基本設定">
					<content>
						<ScrollPane fitToWidth="true" fitToHeight="true" pannable="true" 
						hbarPolicy="NEVER" vbarPolicy="ALWAYS">
							<VBox spacing="15" styleClass="section-border">
								<padding>
									<Insets top="20" right="20" bottom="20" left="20"/>
								</padding>
								<VBox spacing="10" styleClass="section-border">
									<HBox styleClass="setting-header">
										<Label text="ショートカットキー選択" styleClass="section-title"/>
										<Label fx:id="labelKeyCombination" styleClass="current-value"/>
									</HBox>
									<HBox styleClass="setting-header">
										<ComboBox fx:id="comboTriggerType"/>
									</HBox>
									<HBox>
										<Label text="ーーカスタムキー設定ーー"/>
									</HBox>
									<HBox styleClass="setting-header">
										<TextField fx:id="textInputKey" promptText="ショートカットキーにしたいキーを入力" disable="true"/>
										<Label text="+"/>
										<CheckBox fx:id="checkCtrl" text="Ctrl"/>
										<Label text="+"/>
										<CheckBox fx:id="checkAlt" text="Alt"/>
										<Label text="+"/>
										<CheckBox fx:id="checkShift" text="Shift"/>
									</HBox>
								</VBox>
								<VBox spacing="10" styleClass="section-border">
									<HBox styleClass="setting-header">
										<Label text="撮影範囲" styleClass="section-title"/>
										<Label fx:id="labelSnapArea" styleClass="current-value"/>
									</HBox>
									<HBox styleClass="setting-header">
										<ComboBox fx:id="comboSnapArea"/>
									</HBox>
								</VBox>
								<VBox spacing="10">
									<Label text="出力" styleClass="section-main-title" />
								</VBox>
								<VBox spacing="20">
									<VBox spacing="10" styleClass="section-border">
										<Label text="保存方法" styleClass="section-title"/>
										<GridPane hgap="20">
											<columnConstraints>
												<ColumnConstraints percentWidth="50"/>
												<ColumnConstraints percentWidth="50"/>
											</columnConstraints>	
											<VBox spacing="10" GridPane.columnIndex="0">
												<HBox spacing="10" styleClass="output-switch-row, output-switch-item">
													<CheckBox text="画像を保存する" styleClass="switch-check-box" />
													<Label text="有効" styleClass="current-value"/>
												</HBox>
											</VBox>
											<VBox spacing="10" GridPane.columnIndex="1">
												<HBox spacing="10" styleClass="output-switch-row, output-switch-item">
													<CheckBox fx:id="checkClipboard" text="クリップボードに保存する" styleClass="switch-check-box"/>
													<Label text="有効" styleClass="current-value"/>
												</HBox>
											</VBox>
										</GridPane>
										<Accordion fx:id="accordionImageSaveSettings">
											<panes>
												<TitledPane fx:id="paneImageSaveSettings" text="画像保存先の設定" expanded="false" focusTraversable="true">
													<content>
														<VBox spacing="10">
															<HBox styleClass="setting-header">
																<Label text="保存先フォルダ選択" styleClass="section-title"/>
																<Label fx:id="labelFilePath" styleClass="current-value"/>
															</HBox>
															<HBox styleClass="setting-header">
																<Button text="選択..." onAction="#onSelectFile"/>
																<TextField fx:id="textFilePath" promptText="選択されたフォルダ" editable="false"/>
															</HBox>
															<HBox styleClass="setting-header">
																<Label text="画像の拡張子" styleClass="section-title"/>
																<Label fx:id="labelFormatType" styleClass="current-value"/>
															</HBox>
															<HBox styleClass="setting-header">
																<ComboBox fx:id="comboFormatType"/>
															</HBox>
														</VBox>
													</content>
												</TitledPane>
											</panes>
										</Accordion>
									</VBox>
									<VBox spacing="15" styleClass="section-border">
										<GridPane hgap="20">
											<columnConstraints>
												<ColumnConstraints percentWidth="50"/>
												<ColumnConstraints percentWidth="50"/>
											</columnConstraints>
									
											<!-- 左側：撮影後の動作 -->
											<VBox spacing="8" GridPane.columnIndex="0">
												<HBox styleClass="setting-header">
													<Label text="撮影後の動作" styleClass="section-title"/>
													<Label fx:id="labelSnapAfter" styleClass="current-value"/>
												</HBox>
									
												<RadioButton fx:id="radioSnapAfterNothing"/>
												<RadioButton fx:id="radioSnapAfterOpenImage"/>
												<RadioButton fx:id="radioSnapAfterOpenPaint"/>
											</VBox>
									
											<!-- 右側：通知表示 -->
											<VBox spacing="8" GridPane.columnIndex="1">
												<HBox styleClass="setting-header">
													<Label text="通知表示" styleClass="section-title"/>
													<Label text="有効" styleClass="current-value"/>
												</HBox>
												<CheckBox fx:id="checkShowNotification" text="通知を表示する"/>
												<HBox styleClass="setting-header">
													<Label text="撮影音　" styleClass="section-title"/>
													<Label text="無効" styleClass="current-value"/>
												</HBox>
												<CheckBox fx:id="checkSnapSound" text="撮影音を有効にする"/>
											</VBox>
										</GridPane>
									</VBox>
								</VBox>
							</VBox>
						</ScrollPane>
					</content>
				</Tab>
				<Tab fx:id="otherTab" text="その他設定">
					<content>
						<VBox spacing="20">
							<padding>
								<Insets top="20" right="20" bottom="20" left="20"/>
							</padding>
							<Label text="ここに新しい設定項目や、履歴などを追加できます。" />
						</VBox>
					</content>
				</Tab>
			</tabs>
		</TabPane>
	</center>

	<bottom>
		<HBox spacing="20" alignment="CENTER">
			<padding>
				<Insets top="10" right="20" bottom="20" left="20"/>
			</padding>
			<children>
				<Button text="設定を初期化" onAction="#onResetConfig" style="-fx-min-width: 100;"/>
				<Button text="設定を反映" onAction="#onApplyConfig" prefWidth="120" style="-fx-base: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
			</children>
		</HBox>
	</bottom>
</BorderPane>