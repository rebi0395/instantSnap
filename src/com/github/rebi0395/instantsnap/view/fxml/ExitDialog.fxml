<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
	spacing="20" alignment="CENTER" style="-fx-padding: 20;">
	<Label fx:id="labelExitConfirmMessage" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
	<Label fx:id="labelDeleteTmpConfirmMessage" style="-fx-font-size: 14px;" />
	<HBox spacing="10" alignment="CENTER">
		<Button fx:id="buttonApply" text="終了する" prefWidth="100" />
		<Button fx:id="buttonCancel" text="キャンセル" prefWidth="100" />
	</HBox>
</VBox>