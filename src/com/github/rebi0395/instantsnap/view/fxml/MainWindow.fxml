<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

	<top>
		<HBox styleClass="top-bar">
        	<Label fx:id="labelStatus" text="起動中..." />
        	<Region HBox.hgrow="ALWAYS" />
        	<Label text="Language" />
        	<ComboBox fx:id="comboLanguageType" styleClass="language-combo"/>
    	</HBox>
	</top>

	<center>
		<TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="main-tab-pane">
			<tabs>
				<Tab fx:id="tabBasicSettings"><!-- 基本設定 -->
					<content>
						<ScrollPane fitToWidth="true" fitToHeight="true" pannable="true" 
						hbarPolicy="NEVER" vbarPolicy="ALWAYS">
							<VBox spacing="15" styleClass="section-border">
								<padding>
									<Insets top="20" right="20" bottom="20" left="20"/>
								</padding>
								<VBox spacing="10" styleClass="section-border">
									<HBox styleClass="setting-header">
										<Label fx:id="sectionShortcutKey" styleClass="section-title" 
											prefWidth="120" maxWidth="120"/><!-- ショートカットキー選択 -->
										<Label fx:id="labelKeyCombination" styleClass="current-value"/>
									</HBox>
									<HBox styleClass="setting-header">
										<ComboBox fx:id="comboTriggerType"/>
									</HBox>
									<HBox>
										<Label fx:id="sectionCustomKey"/><!-- カスタムキー設定 -->
									</HBox>
									<HBox styleClass="setting-header">
										<TextField fx:id="textInputKey" disable="true"/>
										<Label text="+"/>
										<CheckBox fx:id="checkCtrl" text="Ctrl"/>
										<Label text="+"/>
										<CheckBox fx:id="checkAlt" text="Alt"/>
										<Label text="+"/>
										<CheckBox fx:id="checkShift" text="Shift"/>
									</HBox>
								</VBox>
								<VBox spacing="10" styleClass="section-border">
									<HBox styleClass="setting-header">
										<Label fx:id="sectionSnapArea" styleClass="section-title"
											prefWidth="80" maxWidth="80"/><!-- 撮影範囲 -->
										<Label fx:id="labelSnapArea" styleClass="current-value"/>
									</HBox>
									<HBox styleClass="setting-header">
										<ComboBox fx:id="comboSnapArea"/>
									</HBox>
								</VBox>
								<VBox spacing="20">
									<VBox spacing="10" styleClass="section-border">
										<Label fx:id="sectionSaveMethod" styleClass="section-title"/><!-- 保存方法 -->
										<GridPane hgap="20">
											<columnConstraints>
												<ColumnConstraints percentWidth="50"/>
												<ColumnConstraints percentWidth="50"/>
											</columnConstraints>	
											<VBox spacing="10" GridPane.columnIndex="0">
												<HBox spacing="10" styleClass="output-switch-item">
													<CheckBox fx:id="checkSaveImage" styleClass="switch-check-box"/>
													<!-- 画像を保存する -->
													<Label fx:id="labelSaveImage" styleClass="current-value"/>
												</HBox>
											</VBox>
											<VBox spacing="10" GridPane.columnIndex="1">
												<HBox spacing="10" styleClass="output-switch-item">
													<CheckBox fx:id="checkClipboard" styleClass="switch-check-box"/>
													<!-- クリップボードにコピーする -->
													<Label fx:id="labelClipboard" styleClass="current-value"/>
												</HBox>
											</VBox>
										</GridPane>
										<Accordion fx:id="accordionImageSaveSettings">
											<panes>
												<TitledPane fx:id="accordionSaveDestination" expanded="false" focusTraversable="true"><!-- 画像保存先の設定 -->
													<content>
														<VBox spacing="10">
															<HBox styleClass="setting-header">
																<Label fx:id="sectionSelectSaveDirectory" styleClass="section-title"/><!-- 保存先フォルダを選択 -->
																<Label fx:id="labelFilePath" styleClass="current-value"/>
															</HBox>
															<HBox styleClass="setting-header">
																<Button fx:id="buttonSelectFile" onAction="#onSelectFile"/><!-- 選択...-->
																<TextField fx:id="textFilePath" promptText="選択されたフォルダ" editable="false" styleClass="readonly-text-field"/>
															</HBox>
															<HBox styleClass="setting-header">
																<Label fx:id="sectionFormat" styleClass="section-title"/><!-- 画像の拡張子 -->
																<Label fx:id="labelFormatType" styleClass="current-value"/>
															</HBox>
															<HBox styleClass="setting-header">
																<TextField fx:id="textFileNamePrefix"/>
																<ComboBox fx:id="comboFormatType" prefWidth="70" maxWidth="70"/>
															</HBox>
														</VBox>
													</content>
												</TitledPane>
											</panes>
										</Accordion>
									</VBox>
									<VBox spacing="15" styleClass="section-border">
										<GridPane hgap="20">
											<columnConstraints>
												<ColumnConstraints percentWidth="50"/>
												<ColumnConstraints percentWidth="50"/>
											</columnConstraints>
									
											<!-- 左側：撮影後の動作 -->
											<VBox spacing="10" GridPane.columnIndex="0">
												<HBox styleClass="setting-header">
													<Label fx:id="sectionAfterSnapAction" styleClass="section-title"/><!-- 撮影後の動作 -->
													<Label fx:id="labelSnapAfter" styleClass="current-value"/>
												</HBox>
									
												<RadioButton fx:id="radioSnapAfterNothing"/>
												<RadioButton fx:id="radioSnapAfterOpenImage"/>
												<RadioButton fx:id="radioSnapAfterOpenPaint"/>
												<RadioButton fx:id="radioSnapAfterSaveToTmp"/>
											</VBox>
									
											<!-- 右側：通知表示 -->
											<VBox spacing="10" GridPane.columnIndex="1">
												<HBox styleClass="setting-header">
													<Label fx:id="sectionNotification" styleClass="section-title" prefWidth="80" maxWidth="80"/><!-- 通知表示 -->
													<Label fx:id="labelNotification" styleClass="current-value"/>
												</HBox>
												<HBox spacing="10" styleClass="output-switch-row">
													<CheckBox fx:id="checkNotification" text="通知を表示する" styleClass="switch-check-box"/>
												</HBox>
												<HBox styleClass="setting-header">
													<Label fx:id="sectionSoundTitle" styleClass="section-title"/><!-- サウンド設定 -->
												</HBox>
												<HBox spacing="10" styleClass="output-switch-item">
													<CheckBox fx:id="checkSnapSound" prefWidth="160" maxWidth="160"/><!-- 撮影音を有効にする -->
													<Label fx:id="labelSnapSound" styleClass="current-value"/>
												</HBox>
												<HBox spacing="10" styleClass="output-switch-item">
													<CheckBox fx:id="checkNotificationSound" prefWidth="160" maxWidth="160"/><!-- 通知音を有効にする -->
													<Label fx:id="labelNotificationSound" styleClass="current-value"/>
												</HBox>
											</VBox>
										</GridPane>
									</VBox>
								</VBox>
							</VBox>
						</ScrollPane>
					</content>
				</Tab>
				<Tab fx:id="tabOtherSettings"><!-- その他設定 -->
					<content>
						<VBox spacing="20">
							<padding>
								<Insets top="20" right="20" bottom="20" left="20"/>
							</padding>
							<Label text="ここに新しい設定項目や、履歴などを追加できます。" />
						</VBox>
					</content>
				</Tab>
			</tabs>
		</TabPane>
	</center>

	<bottom>
		<HBox spacing="20" alignment="CENTER">
			<padding>
				<Insets top="10" right="20" bottom="20" left="20"/>
			</padding>
			<children>
				<Button fx:id="buttonReset" onAction="#onResetConfig" style="-fx-min-width: 100;"/><!-- 入力値を初期化 -->
				<Button fx:id="buttonApply" onAction="#onApplyConfig" prefWidth="120" style="-fx-base: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/><!-- 設定を反映 -->
			</children>
		</HBox>
	</bottom>
</BorderPane>